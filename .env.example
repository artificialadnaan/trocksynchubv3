# Bid Board → T Rock CRM ingestion
CRM_BID_BOARD_SYNC_URL=
BID_BOARD_SYNC_SECRET=

# Optional override; defaults to dallas.
CRM_BID_BOARD_SYNC_OFFICE_SLUG=dallas

# SyncHub → T Rock CRM Procore portfolio relay
SYNCHUB_RELAY_SECRET=
TROCKCRM_RELAY_URL=https://api-production-ad218.up.railway.app/api/webhooks/synchub/procore-project-created
TROCKCRM_STAGE_CHANGE_RELAY_URL=
TROCKCRM_RELAY_ENABLED=true

# CRM activity note on Bid Board projects — DEFAULT OFF.
# The note step is skipped entirely (no login, no navigation, no selector lookup) unless this is
# exactly "true". It is off because the Procore Notes selectors are written from published docs, not
# observed DOM: until they are validated they always miss, and the step would navigate and burn its
# section timeout on EVERY create while holding the global browser lock.
# Sequence: POST /api/testing/playwright/bidboard-project-note (the prober, which is NOT gated by this)
# -> substitute the real hooks into server/playwright/selectors.ts -> set this to true.
BIDBOARD_NOTES_ENABLED=false

# Approved service RFP → TROCK Core service estimating lane.
# INERT until BOTH are set: with either unset the handoff writes nothing at all and every service
# approval behaves exactly as it did before this feature existed.
# The base URL is the Core origin only — the path /webhooks/crm/<office>/service-rfp/v1 is appended,
# and the office is derived from the project number's prefix (DFW → dallas; ATL has no Core tenant
# and is refused with an alert).
# The secret must be at least 32 bytes. A SHORTER value does not reach Core and does not 401: the
# producer refuses it locally (resolveServiceRfpIngressSecret returns null), so the handoff stays
# UNPROVISIONED and skips before it enqueues or posts — the same inert state as an empty value. The
# distinction matters when diagnosing: a too-short secret looks like "nothing happened", not like a
# rejected request. It must equal Core's SERVICE_RFP_INGRESS_SECRET_CURRENT. Mind Railway's metachar
# rule — a value containing < > & or spaces kills container start with a successful build.
CORE_INGRESS_BASE_URL=
SERVICE_RFP_INGRESS_SECRET_CURRENT=
