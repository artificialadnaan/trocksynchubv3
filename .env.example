# Bid Board → T Rock CRM ingestion
CRM_BID_BOARD_SYNC_URL=
BID_BOARD_SYNC_SECRET=

# Optional override; defaults to dallas.
CRM_BID_BOARD_SYNC_OFFICE_SLUG=dallas

# SyncHub → T Rock CRM Procore portfolio relay
SYNCHUB_RELAY_SECRET=
TROCKCRM_RELAY_URL=https://api-production-ad218.up.railway.app/api/webhooks/synchub/procore-project-created
TROCKCRM_STAGE_CHANGE_RELAY_URL=
TROCKCRM_RELAY_ENABLED=true

# CRM activity note on Bid Board projects — DEFAULT OFF.
# The note step is skipped entirely (no login, no navigation, no selector lookup) unless this is
# exactly "true". It is off because the Procore Notes selectors are written from published docs, not
# observed DOM: until they are validated they always miss, and the step would navigate and burn its
# section timeout on EVERY create while holding the global browser lock.
# Sequence: POST /api/testing/playwright/bidboard-project-note (the prober, which is NOT gated by this)
# -> substitute the real hooks into server/playwright/selectors.ts -> set this to true.
BIDBOARD_NOTES_ENABLED=false
