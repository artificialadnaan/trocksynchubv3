{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trock:integration-health:snapshot:v1",
  "title": "trock.integration-health.snapshot.v1 (CONTRACT r1 b4616ca1 + ADDENDUM-1). Patterns are ECMA-262 only (no inline flags). Shape only: secret/email checks are each producer's grep test.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "system", "generated_at", "producer_commit", "connections"],
  "properties": {
    "schema": { "const": "trock.integration-health.snapshot.v1" },
    "system": { "enum": ["synchub", "crm", "expense", "core"] },
    "generated_at": { "$ref": "#/$defs/ts" },
    "producer_commit": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }] },
    "connections": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/connection" } }
  },
  "$defs": {
    "ts": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$" },
    "tsOrNull": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/ts" }] },
    "countOrNull": { "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] },
    "safeText": {
      "type": "string", "maxLength": 200,
      "not": { "pattern": "([Bb]earer |BEARER |[Tt]oken=|access_token|refresh_token|eyJ[A-Za-z0-9_-]{10,}|[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}|https?://[^ ]*\\?)" }
    },
    "safeUrlOrNull": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "maxLength": 300, "pattern": "^https://", "not": { "pattern": "([Tt]oken|TOKEN|/rfp-review/|[?&](t|key|sig|code)=)" } }
      ]
    },
    "error": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false, "required": ["code", "at", "message_safe"],
          "properties": {
            "code": { "type": "string", "maxLength": 80, "pattern": "^[A-Za-z0-9_.:-]+$" },
            "at": { "$ref": "#/$defs/tsOrNull" },
            "message_safe": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/safeText" }] }
          }
        }
      ]
    },
    "delivery": {
      "type": "object", "additionalProperties": false,
      "required": ["direction", "pending", "oldest_pending_at", "failed_24h", "failed_7d", "exhausted", "last_delivered_at"],
      "properties": {
        "direction": { "enum": ["out", "in"] },
        "pending": { "$ref": "#/$defs/countOrNull" },
        "oldest_pending_at": { "$ref": "#/$defs/tsOrNull" },
        "failed_24h": { "$ref": "#/$defs/countOrNull" },
        "failed_7d": { "$ref": "#/$defs/countOrNull" },
        "exhausted": { "$ref": "#/$defs/countOrNull" },
        "last_delivered_at": { "$ref": "#/$defs/tsOrNull" }
      }
    },
    "record": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id", "state", "url"],
      "properties": {
        "kind": { "type": "string", "maxLength": 60, "pattern": "^[a-z0-9_]+$" },
        "id": { "type": "string", "maxLength": 80, "pattern": "^[A-Za-z0-9_.:-]+$" },
        "state": { "type": "string", "maxLength": 40, "pattern": "^[A-Za-z0-9_.:-]+$" },
        "url": { "$ref": "#/$defs/safeUrlOrNull" }
      }
    },
    "extraValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 60, "pattern": "^[A-Za-z0-9_.:-]*$" }
      ]
    },
    "connection": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "label", "peer", "direction", "purpose", "impact", "paused", "connection", "processing", "delivery", "records", "correction_url", "extra"],
      "properties": {
        "key": { "type": "string", "maxLength": 80, "pattern": "^(synchub|crm|expense|core)\\.[a-z0-9_.]+$" },
        "label": { "type": "string", "maxLength": 120 },
        "peer": { "type": "string", "maxLength": 60 },
        "direction": { "enum": ["outbound", "inbound", "pull", "bidirectional"] },
        "purpose": { "type": "string", "maxLength": 200 },
        "impact": { "type": "string", "maxLength": 200 },
        "paused": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false, "required": ["reason", "since"],
              "properties": { "reason": { "$ref": "#/$defs/safeText" }, "since": { "$ref": "#/$defs/tsOrNull" } }
            }
          ]
        },
        "connection": {
          "type": "object", "additionalProperties": false,
          "required": ["credential_present", "expires_at", "last_auth_ok_at", "last_auth_error"],
          "properties": {
            "credential_present": { "anyOf": [{ "type": "null" }, { "type": "boolean" }] },
            "expires_at": { "$ref": "#/$defs/tsOrNull" },
            "last_auth_ok_at": { "$ref": "#/$defs/tsOrNull" },
            "last_auth_error": { "$ref": "#/$defs/error" }
          }
        },
        "processing": {
          "type": "object", "additionalProperties": false,
          "required": ["last_attempt_at", "last_success_at", "cadence_seconds", "next_run_at", "last_error"],
          "properties": {
            "last_attempt_at": { "$ref": "#/$defs/tsOrNull" },
            "last_success_at": { "$ref": "#/$defs/tsOrNull" },
            "cadence_seconds": { "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }] },
            "next_run_at": { "$ref": "#/$defs/tsOrNull" },
            "last_error": { "$ref": "#/$defs/error" }
          }
        },
        "delivery": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/delivery" } },
        "records": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/record" } },
        "correction_url": { "$ref": "#/$defs/safeUrlOrNull" },
        "extra": {
          "type": "object", "maxProperties": 20,
          "propertyNames": { "pattern": "^[a-z0-9_.:-]{1,60}$" },
          "additionalProperties": { "$ref": "#/$defs/extraValue" }
        }
      }
    }
  }
}
